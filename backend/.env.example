# Copy this file to .env and fill in real values.

# Required for Layer 6 live LLM code inspection. Without this, Layer 6 falls
# back to a keyword-overlap heuristic instead of calling Gemini -- the rest
# of the framework works fully without it.
GEMINI_API_KEY=

# Only needed if running with --out db instead of --out csv, or once the API
# is switched to a Postgres-backed data path. Matches docker-compose.yml's
# postgres service by default.
DATABASE_URL=postgresql://rca:rca_dev_password@postgres:5432/rca_framework
